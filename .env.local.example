APP_NAME=Dog Breed Recognition TP2
# Modelo usado para generar embeddings en la busqueda por similitud:
# baseline (pre-entrenado ImageNet) | resnet18_finetuned | cnn_custom
EMBEDDING_MODEL=baseline
MODEL_PATH=../models
RESNET18_MODEL_NAME=resnet18_finetuned.pth
CNN_CUSTOM_MODEL_NAME=cnn_custom.pth
# Cache de pesos preentrenados de torchvision (no se descargan de nuevo al recrear el contenedor)
TORCH_HOME=../models/torch

# Busqueda por similitud
SIMILARITY_METRIC=cosine
# Calibrado con valid en 2-train.ipynb (seccion 5.4), para embeddings baseline
SIMILARITY_THRESHOLD=0.82
# Cantidad de vecinos a recuperar (Top K)
TOP_K=10
IMAGE_SIZE=224
# Debe coincidir con la dimension del embedding del modelo elegido (ResNet50 GAP = 2048, ResNet18 = 512)
EMBEDDING_DIM=512

# Configuracion de YOLO (Etapa 3)
# Ruta dentro de models/: ultralytics descarga ahi los pesos en el primer uso
YOLO_MODEL=../models/yolov8n.pt
YOLO_CONF_THRESHOLD=0.25
# Clase 'dog' en COCO
YOLO_DOG_CLASS_ID=16

# Entrenamiento de los clasificadores (Etapa 2)
# CSV de splits generado en 1-pre-processing.ipynb: columnas filepaths,labels,"data set"
# (rutas relativas a DATASET_PATH)
SPLITS_FILE=../data/splits.csv
TRAIN_EPOCHS=10
TRAIN_BATCH_SIZE=32
TRAIN_LR=0.001
TRAIN_WEIGHT_DECAY=0.0001
TRAIN_LABEL_SMOOTHING=0.1
TRAIN_DROPOUT=0.3
# Early stopping: epocas sin mejora en valid antes de cortar
TRAIN_PATIENCE=3
TRAIN_SEED=42
# Estrategia del Modelo A: head (backbone congelado) | layer4 (descongela el ultimo bloque)
RESNET_FINETUNE=head
# Maximo de imagenes por raza (0 = todas); util para pruebas rapidas
TRAIN_LIMIT_PER_CLASS=0

# Paths (relativos a src/, que es desde donde corre el backend local)
EMBEDDINGS_PATH=../data/embeddings.json
DATA_PATH=../data
DATASET_PATH=../data/dataset
OUTPUT_PATH=../output
# Origenes permitidos para CORS (coma). Use * en desarrollo.
CORS_ORIGINS="http://localhost:8080"
MAX_WORKERS=2

# PostgreSQL / pgvector
USE_PGVECTOR=true
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dogs
POSTGRES_USER=dogs_user
POSTGRES_PASSWORD=dogs_pass
